# Front end (Next.js). Copy to .env.local for local development.

# Where the browser connects for the game server.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Public URL of the site, used for link previews. Optional.
# NEXT_PUBLIC_SITE_URL=https://your-site.example


# Game server (server/socketServer.js). Set these on the server's host.

# Front-end origin(s) allowed to connect. Comma-separate several.
CLIENT_URL=http://localhost:3000

# Port to listen on. Most hosts set this for you.
PORT=3001
